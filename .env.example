# NetBird (self-hosted) - required for the control plane
NETBIRD_DOMAIN=netbird.local
NETBIRD_HTTP_PROTOCOL=http
NETBIRD_SERVER_PORT=9081
NETBIRD_DASHBOARD_PORT=9080

# URLs used by the control plane (internal Docker network by default)
NETBIRD_API_URL=http://netbird-server/api
NETBIRD_MANAGEMENT_URL=http://netbird-server

# NetBird API token (dashboard > Settings > Access Tokens)
NETBIRD_TOKEN=

# Admin API service token for calling the control plane (create via CLI or CP host)
ADMIN_API_KEY=

POSTGRES_PASSWORD=platform
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minioadmin
