# Traefik static configuration for Platform gateway routes.
# Generated by render-traefik-config.mjs from PLATFORM_TLS_MODE and related env vars.
# Dynamic routes are polled from the HTTP provider (control plane pushes via PUT to that store).

global:
    checkNewVersion: false
    sendAnonymousUsage: false

api:
    dashboard: true
    insecure: true

entryPoints:
    web:
        address: ":80"
    websecure:
        address: ":443"
{{WEBSECURE_TLS_OPTIONS}}

providers:
    http:
        endpoint: "http://traefik-dynamic-config:8099/platform/dynamic-config"
        pollInterval: "2s"
        pollTimeout: "5s"

{{CERTIFICATES_RESOLVERS}}
{{TLS_STORES}}
