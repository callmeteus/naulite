# NetBird (self-hosted, internal only)
NETBIRD_DOMAIN=netbird.local
NETBIRD_HTTP_PROTOCOL=http
NETBIRD_SERVER_PORT=9081

# Public URLs used by remote agents during bootstrap
PLATFORM_PUBLIC_URL=
NETBIRD_PUBLIC_MANAGEMENT_URL=

# URLs used by the control plane (internal Docker network by default)
NETBIRD_API_URL=http://netbird-server/api
NETBIRD_MANAGEMENT_URL=http://netbird-server

# NetBird setup key for dogfood agent enrollment (auto-created by dogfood/bin/dev when empty)
NETBIRD_SETUP_KEY=

# Admin API service token for calling the control plane (auto-created by bin/dev when empty)
ADMIN_API_KEY=

POSTGRES_PASSWORD=platform
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replicator
POSTGRES_HA_ENABLED=true

# Optional: override when using external RDS instead of local pgpool
# DATABASE_URL=postgres://platform:platform@your-rds-host:5432/platform

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minioadmin

# Optional metrics stack host port (see packages/metrics/compose/metrics-stack.yml)
PLATFORM_PROMETHEUS_HOST_PORT=19090

# Traefik TLS mode: acme_tls | acme_dns_cloudflare | passthrough | self_signed | custom
PLATFORM_TLS_MODE=acme_tls
ACME_EMAIL=platform@localhost
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# Required when PLATFORM_TLS_MODE=acme_dns_cloudflare
CF_DNS_API_TOKEN=

# Control plane plugins enabled at runtime (comma-separated ids)
# CP_PLUGINS=s3,slack,webhook

# Optional Slack pipeline notifications
# PLATFORM_SLACK_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=

# Optional generic webhook pipeline notifications
# PLATFORM_WEBHOOK_URL=
# WEBHOOK_URL=
# PLATFORM_WEBHOOK_SECRET=
